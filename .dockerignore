*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

.venv/
venv/
env/

.env
.env.*
!.env.example

.vscode/
.idea/
.DS_Store

tests/
deploy/
README.md
LICENSE
fix_batch2.py

*.zip
*.rar
*.patch
*.log
